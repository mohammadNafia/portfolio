{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Base config. Neither of these names is deployed to directly — every deploy
  // goes through `--env production` or `--env staging`, which override `name`.
  // The bare `portfolio` name exists only so `wrangler` has a valid default.
  "name": "portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",

  // `nodejs_compat` is required by OpenNext — the Next.js server runtime pulls
  // in node:* builtins. `global_fetch_strictly_public` makes fetches to the
  // Worker's own hostname go back out through the edge rather than looping
  // internally, which is what Next's server-side data fetching expects.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Prerendered pages, `/img/**` variants and other static files. Served from
  // the asset store, NOT the Worker bundle — none of this counts against the
  // 3 MiB compressed Worker limit.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Workers Logs, verified against Cloudflare's docs as included on BOTH the
  // Free and Paid plans — not a paid-only feature and not a billing risk.
  //   Free: 200,000 log events/day, 3-day retention
  //   Paid: 20M/month included, then $0.60/million, 7-day retention
  // A portfolio site will not approach 200k events/day. Logpush is the part
  // that needs Business/Enterprise; this is not that.
  "observability": {
    "enabled": true
  },

  // ---------------------------------------------------------------------------
  // No `vars` block anywhere in this file, by policy.
  //
  // Runtime secrets (RESEND_API_KEY, CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL) are
  // set with `wrangler secret put --env <env>`; this file is committed and
  // public, so nothing sensitive can live here.
  //
  // NEXT_PUBLIC_SITE_URL is a *build-time* variable — Next.js inlines
  // `NEXT_PUBLIC_*` into the bundle and the sitemap/robots/canonical URLs are
  // baked during prerender. Setting it as a Worker var would have no effect.
  // It belongs in the build environment. See DEPLOY.md.
  // ---------------------------------------------------------------------------

  "env": {
    "production": {
      "name": "portfolio-production",

      // The apex is the single canonical host. `custom_domain: true` makes
      // wrangler create the Custom Domain and its proxied DNS record itself —
      // Workers Custom Domains only function proxied, so there is no
      // grey-cloud option here and nothing to add by hand.
      //
      // `www` is deliberately NOT a second Custom Domain: two Custom Domains
      // means two live hosts serving identical content. It is a Redirect Rule
      // to the apex instead, so there is exactly one indexable surface.
      "routes": [{ "pattern": "mohammednafia.com", "custom_domain": true }],

      // Adding `routes` makes wrangler default `workers_dev` to FALSE, which
      // silently retires the .workers.dev URL. That is not wanted here: it is
      // the fallback used to verify a deploy before DNS is trusted, and losing
      // it while a Custom Domain is still provisioning leaves no reachable URL
      // at all. Keeping both live costs nothing in SEO — every page carries a
      // canonical pointing at the apex, so the workers.dev copy de-duplicates
      // itself.
      "workers_dev": true,

      "compatibility_date": "2026-08-01",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": { "enabled": true }
    },

    "staging": {
      "name": "portfolio-staging",
      "compatibility_date": "2026-08-01",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": { "enabled": true }
    }
  }
}
