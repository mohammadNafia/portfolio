{
  "name": "mohammed-nafia-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual portfolio for Mohammed Nafia — Full-Stack Software Engineer and Product Founder, Baghdad, Iraq.",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run lint && npm run typecheck && npm test && npm run clean && npm run build",
    "shots": "node scripts/restart-prod.mjs && node scripts/shoot.mjs",
    "images": "node scripts/optimize-images.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:size": "node scripts/worker-size.mjs",
    "deploy:staging": "opennextjs-cloudflare deploy -- --env staging",
    "deploy:production": "opennextjs-cloudflare deploy -- --env production",
    "clean": "node -e \"fs.rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.6",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
