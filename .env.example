# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# Every variable here is OPTIONAL — the site builds and runs without any of them.
# ---------------------------------------------------------------------------

# Public site origin. Feeds canonical URLs, sitemap.xml, robots.txt, Open Graph
# URLs and the Person structured data.
#
# MUST be set before launch. Without it the site falls back to a placeholder
# domain and search engines will index canonical URLs pointing at it.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Contact form delivery (Resend — https://resend.com)
#
# With no key configured, POST /api/contact returns `unavailable` and the form
# tells the visitor plainly that the message was NOT delivered, showing the
# direct email address instead. It never reports a fake success.
# ---------------------------------------------------------------------------

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Inbox that receives inquiries. Defaults to the address in src/lib/site.ts.
# CONTACT_TO_EMAIL=mohammadnafia1@gmail.com

# Verified sender. Must be a domain verified with the provider.
# CONTACT_FROM_EMAIL=Portfolio <hello@your-domain.com>
